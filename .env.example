# Oracle Arc local personal core — server-side only. Never commit real .env values.
ORACLE_ARC_API_KEY=replace-with-a-long-random-secret
ORACLE_ARC_MODEL=qwen2.5:7b
# Only implemented provider in this release. Unknown providers fail closed.
ORACLE_ARC_PROVIDER=ollama
ORACLE_ARC_DB_PATH=data/oracle_arc.sqlite3

# API guardrails (single-process; place a trusted gateway in front of multi-worker deployments).
ORACLE_ARC_MAX_REQUEST_BYTES=1048576
ORACLE_ARC_RATE_LIMIT_REQUESTS=60
ORACLE_ARC_RATE_LIMIT_WINDOW_SECONDS=60
ORACLE_ARC_CHAT_CONCURRENCY=1
ORACLE_ARC_OLLAMA_TIMEOUT_SECONDS=120

# Plugins run in-process and are not sandboxed. Keep disabled; development only.
ORACLE_ARC_ENABLE_INPROCESS_PLUGINS=false
# Comma-separated plugin filename stems, used only with the unsafe development opt-in.
ORACLE_ARC_TRUSTED_PLUGINS=

# Ollama defaults to http://127.0.0.1:11434. Keep it on a trusted local/private network.
# Localhost is the default. Remote Ollama requires HTTPS and explicit opt-in.
OLLAMA_HOST=http://127.0.0.1:11434
ORACLE_ARC_ALLOW_REMOTE_OLLAMA=false
