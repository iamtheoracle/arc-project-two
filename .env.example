# Oracle Arc local personal core — server-side only. Never commit real .env values.
ORACLE_ARC_API_KEY=replace-with-a-long-random-secret
ORACLE_ARC_MODEL=qwen2.5:7b
ORACLE_ARC_DB_PATH=data/oracle_arc.sqlite3
# Separate compatibility database for the older /v1/tenants API identity schema.
# Do not point this at ORACLE_ARC_DB_PATH; the two schemas are intentionally isolated.
ORACLE_ARC_TENANT_IDENTITY_DB_PATH=data/oracle_arc_tenant_identity.sqlite3

# Ollama defaults to http://127.0.0.1:11434. Keep it on a trusted local/private network.
OLLAMA_HOST=http://127.0.0.1:11434
ORACLE_ARC_PROVIDER=ollama

# Optional remote model providers. These are disabled until a server-side key is configured.
# The platform worker independently blocks remote inference for non-public data.
ORACLE_ARC_OPENROUTER_API_KEY=
ORACLE_ARC_OPENROUTER_MODEL=openai/gpt-4o-mini
ORACLE_ARC_GROQ_API_KEY=
ORACLE_ARC_GROQ_MODEL=llama-3.3-70b-versatile
ORACLE_ARC_GEMINI_API_KEY=
ORACLE_ARC_GEMINI_MODEL=gemini-2.5-flash
ORACLE_ARC_CLAUDE_API_KEY=
ORACLE_ARC_CLAUDE_MODEL=claude-sonnet-4-5
ORACLE_ARC_CLAUDE_MAX_TOKENS=4096
ORACLE_ARC_REMOTE_PROVIDER_TIMEOUT_SECONDS=30
