# Oracle Arc local personal core — server-side only. Never commit real .env values.
ORACLE_ARC_API_KEY=replace-with-a-long-random-secret
ORACLE_ARC_MODEL=qwen2.5:7b
ORACLE_ARC_DB_PATH=data/oracle_arc.sqlite3
# Separate compatibility database for the older /v1/tenants API identity schema.
# Do not point this at ORACLE_ARC_DB_PATH; the two schemas are intentionally isolated.
ORACLE_ARC_TENANT_IDENTITY_DB_PATH=data/oracle_arc_tenant_identity.sqlite3

# Ollama defaults to http://127.0.0.1:11434. Keep it on a trusted local/private network.
OLLAMA_HOST=http://127.0.0.1:11434

# Optional browser access. Comma-separated exact HTTPS origins only; never use '*'.
ORACLE_ARC_CORS_ORIGINS=https://arc.example.com

# Worker and provider request budgets. Per-request provider timeouts are capped by
# the remaining execution deadline.
ORACLE_ARC_EXECUTION_TIMEOUT_SECONDS=300
ORACLE_ARC_OLLAMA_TIMEOUT_SECONDS=120
ORACLE_ARC_REMOTE_PROVIDER_TIMEOUT_SECONDS=30

# Optional prebuilt rootless Podman image for isolated ORBITS media processing.
# Build locally with: bash scripts/build-orbits-worker.sh
ORACLE_ARC_ORBITS_WORKER_IMAGE=oracle-arc-orbits-worker:local

# Bounded media uploads are allowed a separate request budget from ordinary API calls.
ORACLE_ARC_MEDIA_MAX_REQUEST_BYTES=36000000

# Quarantine storage and ClamAV scanner. Uploads fail closed if ClamAV is unavailable.
ORACLE_ARC_QUARANTINE_DIR=data/quarantine
ORACLE_ARC_CLAMSCAN=clamscan

# Separate offline ORBITS ASR worker. Provision a pinned model before enabling.
ORACLE_ARC_ASR_WORKER_IMAGE=oracle-arc-asr-worker:local
ORACLE_ARC_ASR_MODEL_DIR=/opt/oracle-arc/models/whisper-small
