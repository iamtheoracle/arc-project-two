# Build with: ORACLE_ARC_PLUGIN_WORKER_IMAGE=oracle-arc-plugin-worker:local sh scripts/build-plugin-worker.sh
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --chown=65534:65534 core/plugin_worker.py /app/plugin_worker.py
USER 65534:65534
CMD ["python", "-I", "/app/plugin_worker.py"]
