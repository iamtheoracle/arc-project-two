FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
RUN python -m pip install --no-cache-dir "piper-tts==1.3.0"
RUN mkdir -p /models/active && chown -R 65534:65534 /models
WORKDIR /app
COPY --chown=65534:65534 core/orbits_tts_worker.py /app/orbits_tts_worker.py
USER 65534:65534
CMD ["python", "-I", "/app/orbits_tts_worker.py"]
