FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir "Pillow>=10.4,<12" "pypdf>=5,<7" \
    "pytesseract>=0.3.13,<0.4" "mutagen>=1.47,<2"
WORKDIR /app
COPY --chown=65534:65534 core/orbits_worker.py /app/orbits_worker.py
USER 65534:65534
CMD ["python", "-I", "/app/orbits_worker.py"]
